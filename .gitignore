# Common ignore patterns, these rules applies in both root and subdirectories.
.DS_Store
.eslintcache
.gitpod.yml
.idea
**/*.swp
gotests.coverage
gotests.xml
gotests_stats.json
gotests.json
node_modules/
vendor/
yarn-error.log
.mypy_cache
.setup_complete
.mnist_cache
.artifacts
.uv-cache
.venv
__pycache__

# VSCode settings.
**/.vscode/*
# Allow VSCode recommendations and default settings in project root.
!/.vscode/extensions.json
!/.vscode/settings.json

# Front-end ignore patterns.
.next/
site/build-storybook.log
site/coverage/
site/storybook-static/
site/test-results/*
site/e2e/test-results/*
site/e2e/states/*.json
site/e2e/.auth.json
site/playwright-report/*
site/.swc

# Temporary and localized files
$*
.bak

# Make target for updating golden files (any dir).
.gen-golden

# Build
build/
dist/
out/

# Bundle analysis
site/stats/

*.tfstate
*.tfstate.backup
*.tfplan
*.lock.hcl
.terraform/

**/.coderv2/*
**/__debug_bin

# direnv
.env
.envrc
*.test

# Loadtesting
./scaletest/terraform/.terraform
./scaletest/terraform/.terraform.lock.hcl
scaletest/terraform/secrets.tfvars
.terraform.tfstate.*

# Nix
result

# Data dumps from unit tests
**/*.test.sql

# Filebrowser.db
**/filebrowser.db

# Drawio files
*.bkp

# Pdflatex output
main.pdf
*.aux
*.log
*.out
*.snm
*.toc
*.xml
*.fls
*.fdb_latexmk
*.blg
*.bcf
*.bbl
*.synctex.gz
*.synctex(busy)
*.nav

# Agentic run output, regenerated by agentic/dispatch.sh
jail/

# Readout artifacts, regenerated by genreadout.py and the agentic runs
readout.safetensors
episodes-gate.tar.gz

# Whitened vectors staged for the dose job, fetched from probes-lda on the server
lda.safetensors
permuted.safetensors
permuted-whitened.safetensors

*.tar.gz

*.tar.gz
mechplot.pdf
